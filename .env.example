# Copy this file to .env and fill in your own key. Never commit .env.

# OpenAI (required: the app stops at startup without a key)
OPENAI_API_KEY=

# OpenAI models
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# How much the chat model reasons before it answers: none, low, medium, high, xhigh, or max
OPENAI_REASONING_EFFORT=none

# LangSmith tracing (optional): leave the key empty to run without tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=who-to-ask
# Only for a LangSmith account outside the US region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# MongoDB: where the database is, and its name. These two values are the defaults, for a MongoDB on this computer
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=who_to_ask

# Postgres (optional): the memory of the conversations, so a follow-up question knows who "her" is.
# The database must exist first (create who_to_ask in pgAdmin). Leave the line out to run without Postgres:
# the app then keeps its conversations in its own memory, and forgets them when it stops.
# In the password, write @ : / ? # % as %40 %3A %2F %3F %23 %25
# POSTGRES_URI=postgresql://postgres:YOUR_PASSWORD@localhost:5432/who_to_ask

# The folder with the fake company data. It is the seed source of MongoDB: python -m scripts.seed_mongodb
DATA_DIR=data

# A fixed fake "today", so date logic and tests give the same result every day
TODAY=2026-11-01
